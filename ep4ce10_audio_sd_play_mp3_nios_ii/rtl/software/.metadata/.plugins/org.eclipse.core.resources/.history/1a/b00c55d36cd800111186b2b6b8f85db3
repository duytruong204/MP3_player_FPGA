int decode_and_play_mp3(const char *filename) {
    // 1. Open the file via Altera SD Card Avalon Component Interface
    short int file_handle = alt_up_sd_card_fopen(filename, false);
    if (file_handle < 0) {
        printf("ERROR: Could not open file %s\n", filename);
        return -1;
    }

    // Static buffer to optimize memory and prevent Stack Overflow on Nios II
    static unsigned char sector_buffer[SD_BUFFER_SIZE];
    int bytes_in_buffer = 0;
    int buffer_idx = 0;
    int ram_index = 0;
    int file_ended = 0;

    // Initialize control PIO data states
    IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_IDLE_PIO_BASE, 1);
    IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_EN_PIO_BASE, 0);
    printf("Starting Optimized MP3 Streaming...\n");

    while (1) {
        // Top-up the buffer if data is running low and EOF hasn't been reached
        if ((bytes_in_buffer - buffer_idx) < (NUM_MP3_RAM_ADDR * 2) && !file_ended) {
            // Shift remaining unread bytes to the front of the buffer
            int remaining = bytes_in_buffer - buffer_idx;
            if (remaining > 0 && buffer_idx > 0) {
                memmove(sector_buffer, &sector_buffer[buffer_idx], remaining);
                bytes_in_buffer = remaining;
            } else {
                bytes_in_buffer = 0;
            }
            buffer_idx = 0;

            // Stream contiguous bytes into local RAM array to reduce SPI polling latency
            while (bytes_in_buffer < SD_BUFFER_SIZE) {
                short int raw_byte = alt_up_sd_card_read(file_handle);
                if (raw_byte < 0) { // Caught EOF (-1) or SD Card physical disconnect error
                    file_ended = 1;
                    break;
                }
                sector_buffer[bytes_in_buffer++] = (unsigned char)raw_byte;
            }
        }

        // Termination Condition: End of file reached AND local buffer is completely drained
        if (file_ended && (buffer_idx >= bytes_in_buffer)) {
            printf("\nPlayback Finished Cleanly.\n");
            break;
        }

        // Check if hardware requests a new burst allocation chunk
        if (IORD_ALTERA_AVALON_PIO_DATA(MP3_WR_REQUEST_PIO_BASE) == 1) {

            // Clear IDLE flag to indicate memory transaction processing activity
            IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_IDLE_PIO_BASE, 0);

            // Execute high-speed data burst to hardware RAM/FIFO block
            while (ram_index < NUM_MP3_RAM_ADDR) {
                // Safeguard against mid-burst underflows
                if (buffer_idx + 1 >= bytes_in_buffer) {
                    break;
                }

                // Extract 2 bytes from fast local array memory (Zero SPI overhead)
                unsigned char byte1 = sector_buffer[buffer_idx++];
                unsigned char byte2 = sector_buffer[buffer_idx++];
                unsigned short mp3_data_16bit = ((unsigned short)byte1 << 8) | byte2;

                // Drive Address and Data busses concurrently
                IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_ADDR_PIO_BASE, ram_index);
                IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_DATA_PIO_BASE, mp3_data_16bit);

                // Generate minimum width Write-Enable strobe edge pulse
                IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_EN_PIO_BASE, 1);
                IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_EN_PIO_BASE, 0);

                ram_index++;
            }

            // Reset RAM pointer context index for the next hardware request cycle
            ram_index = 0;

            // Set IDLE flag to release system handshake control state
            IOWR_ALTERA_AVALON_PIO_DATA(MP3_WR_IDLE_PIO_BASE, 1);
        }
    }

    // Safely unmount file resource pointers
    alt_up_sd_card_fclose(file_handle);
    return 0;
}
